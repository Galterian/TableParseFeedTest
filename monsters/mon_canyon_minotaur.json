                ]
              }
            ]
          }
        },
        {
          "id": "dice_face_A",
          "description": "Number of Attack (red) faces among the dice thrown (default BMAP); a literal because JsonLogic cannot count letters in a string.",
          "target": "caster",
          "unit": "die",
          "value": 1
        },
        {
          "id": "dice_face_B",
          "description": "Number of Block (green) faces among the dice thrown (default BMAP); a literal because JsonLogic cannot count letters in a string.",
          "target": "caster",
          "unit": "die",
          "value": 1
        },
        {
          "id": "dice_face_M",
          "description": "Number of Move (blue/white) faces among the dice thrown (default BMAP); a literal because JsonLogic cannot count letters in a string.",
          "target": "caster",
          "unit": "die",
          "value": 1
        },
        {
          "id": "dice_face_P",
          "description": "Number of Posture (black) faces among the dice thrown (default BMAP); a literal because JsonLogic cannot count letters in a string.",
          "target": "caster",
          "unit": "die",
          "value": 1
        },
        {
          "id": "rider_bonus_damage",
          "description": "No on-action rider — always 0.",
          "target": "target",
          "unit": "damage",
          "value": 0
        },
        {
          "id": "base_attack_damage",
          "description": "Resolution-matrix damage of the monster's revealed action against the defender's (1 for Attack, +1 on a winning edge, Attack vs Posture = 2).",
          "target": "target",
          "unit": "damage",
          "value": {
            "rule": [
              "rps_edge",
              {
                "actor": {
                  "var": "unit.action"
                },
                "defender": {
                  "var": "defender.action"
                }
              }
            ]
          }
        },
        {
          "id": "damage_taken_from_cast",
          "description": "Rule 21: damage a completed cast by `caster` with `elements` does to this creature with its canonical stats (its high stat shrugs those elements off).",
          "target": "caster",
          "unit": "damage",
          "value": {
            "rule": [
              "rule_21_delta_damage",
              {
                "caster": {
                  "root": "caster"
                },
                "defender": {
                  "root": "entry.data"
                },
                "elements": {
                  "root": "elements"
                }
              }
            ]
          }
        },
        {
          "id": "regeneration",
          "description": "Rule 3: with no enemy in contact the monster regenerates to full — life restored this turn; 0 while engaged.",
          "target": "caster",
          "unit": "life",
          "value": {
            "if": [
              {
                "rule": [
                  "in_contact",
                  {
                    "dist": {
                      "var": "dist"
                    }
                  }
                ]
              },
              0,
              {
                "max0": [
                  {
                    "-": [
                      {
                        "var": "unit.life_max"
                      },
                      {
                        "var": "unit.life"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "deck_effect_cards",
          "description": "Effect cards in a monster deck of this creature: its deck_effects plus the random ones (rule_monster_deck_effects data.monster_deck.random).",
          "target": "caster",
          "unit": "cards",
          "value": {
            "+": [
              {
                "len": [
                  {
                    "var": "entry.data.deck_effects"
                  }
                ]
              },
              {
                "entry": [
                  "rule_monster_deck_effects",
                  "monster_deck.random"
                ]
              }
            ]
          }
        }
      ],
      "validation": [
        {
          "id": "stats_within_5_each",
          "description": "Each of the four stats may move at most ±5 from the canonical value.",
          "assert": {
            "and": [
              {
                "<=": [
                  {
                    "abs": [
                      {
                        "-": [
                          {
                            "var": "proposal.data.stats.vitality"
                          },
                          {
                            "var": "entry.data.stats.vitality"
                          }
                        ]
                      }
                    ]
