                  5
                ]
              },
              {
                "<=": [
                  {
                    "abs": [
                      {
                        "-": [
                          {
                            "var": "proposal.data.stats.world"
                          },
                          {
                            "var": "entry.data.stats.world"
                          }
                        ]
                      }
                    ]
                  },
                  5
                ]
              },
              {
                "<=": [
                  {
                    "abs": [
                      {
                        "-": [
                          {
                            "var": "proposal.data.stats.matter"
                          },
                          {
                            "var": "entry.data.stats.matter"
                          }
                        ]
                      }
                    ]
                  },
                  5
                ]
              },
              {
                "<=": [
                  {
                    "abs": [
                      {
                        "-": [
                          {
                            "var": "proposal.data.stats.will"
                          },
                          {
                            "var": "entry.data.stats.will"
                          }
                        ]
                      }
                    ]
                  },
                  5
                ]
              }
            ]
          }
        },
        {
          "id": "life_matches_proposal_stats",
          "description": "life equals round_half_up(Σ proposal stats / 10).",
          "assert": {
            "==": [
              {
                "var": "proposal.data.life"
              },
              {
                "rule": [
                  "life_from_stats",
                  {
                    "stats": {
                      "var": "proposal.data.stats"
                    }
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "actions_per_round_unchanged_1_4",
          "description": "actions_per_round stays 1..4 and is not changed by a rebalance.",
          "assert": {
            "and": [
              {
                ">=": [
                  {
                    "var": "proposal.data.actions_per_round"
                  },
                  1
                ]
              },
              {
                "<=": [
                  {
                    "var": "proposal.data.actions_per_round"
                  },
